# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Required in production for webhook HMAC validation
TWILIO_AUTH_TOKEN=

# Public HTTPS base URL for webhooks (no trailing slash)
WEBHOOK_BASE_URL=https://your-domain.example.com

# Environment: development | production
ENV=development

# Security
ENFORCE_HTTPS=0
ENFORCE_TWILIO_HMAC=0
WEBHOOK_ALLOWED_IPS=

# Admin / service auth
ADMIN_API_KEY=
SERVICE_API_KEY=

# Multi-tenant
DEFAULT_TENANT_ID=default
DEFAULT_REGION=eu

# Redis (job queue, rate limits, memory)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=0

# PostgreSQL (production) — leave empty for SQLite dev mode
DATABASE_URL=

# Data retention hours by tier
DATA_RETENTION_HOURS=12
RETENTION_HOURS_FREE=12
RETENTION_HOURS_STANDARD=168
RETENTION_HOURS_PREMIUM=720

# Azure Key Vault optional
AZURE_KEY_VAULT_URL=

# Tavily (optional)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# Google Maps / Places — opening hours on setup preview (enable Places API)
GOOGLE_MAPS_API_KEY=

# LLM — ollama (dev) or openai (production)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_VISION_TIMEOUT=180
SETUP_VISION_MAX_PIXELS=1024
OLLAMA_NUM_PREDICT=350
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Vector RAG
USE_VECTOR_RAG=1

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Google Calendar — OAuth (recommended for customers)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Google Calendar — service account (optional fallback)
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# Landing page CORS (whatsapp-saas-landing — add your Vercel/Netlify URL after deploy)
LANDING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://whatsapp-saas-landing-beryl.vercel.app
LANDING_URL=https://whatsapp-saas-landing-beryl.vercel.app

# Slack handoff
SLACK_WEBHOOK_URL=

# Observability
SENTRY_DSN=
APP_VERSION=1.0.0

# Human handoff
HANDOFF_EMAIL=
HANDOFF_WEBHOOK_URL=

# Owner summary e-mail (SMTP — optional; without SMTP, e-mails go to .user_data/email_outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
NOTIFY_FROM_EMAIL=

# Legal pages (defaults to /privacy and /terms on same host)
PRIVACY_POLICY_URL=
TERMS_URL=

# Server
PORT=5000
FLASK_DEBUG=0

# MCP server (Cursor, OpenAI Remote MCP, admin copilot)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_API_KEY=
MCP_TRANSPORT=stdio
